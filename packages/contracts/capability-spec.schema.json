{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sensemu.dev/capability-spec/v1.json",
  "title": "SenseMu Capability Spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "sensemu.ai/v1" },
    "kind": { "const": "CapabilitySpec" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "workspace_id", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
        "version": { "type": "integer", "minimum": 1 },
        "workspace_id": { "type": "string", "format": "uuid" },
        "status": { "const": "published" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "problem_definition",
        "input",
        "output",
        "applicability",
        "evidence",
        "implementation",
        "delivery"
      ],
      "properties": {
        "display_name": { "type": "string", "minLength": 2, "maxLength": 180 },
        "problem_definition": { "type": "string", "minLength": 16, "maxLength": 1500 },
        "input": { "type": "object" },
        "output": { "type": "object" },
        "applicability": { "type": "object" },
        "evidence": { "type": "object" },
        "implementation": { "type": "object" },
        "delivery": { "type": "object" }
      }
    }
  }
}
