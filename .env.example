# Core API
SENSEMU_API_URL=http://localhost:8000
NEXT_PUBLIC_SENSEMU_API_URL=http://localhost:8000
SENSEMU_PREVIEW_MODE=false
NEXT_PUBLIC_SENSEMU_PREVIEW_MODE=false
SENSEMU_API_PUBLIC_URL=http://localhost:8000
SENSEMU_ENVIRONMENT=development
SENSEMU_API_HOST=0.0.0.0
SENSEMU_API_PORT=8000
SENSEMU_DATABASE_URL=postgresql+psycopg://sensemu:sensemu@localhost:5432/sensemu
SENSEMU_REDIS_URL=redis://localhost:6379/0
SENSEMU_CELERY_BROKER_URL=redis://localhost:6379/1
SENSEMU_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
SENSEMU_OBJECT_STORAGE_ACCESS_KEY=sensemu
SENSEMU_OBJECT_STORAGE_SECRET_KEY=change-me-in-local-env
SENSEMU_OBJECT_STORAGE_BUCKET=sensemu-dev
SENSEMU_OBJECT_STORAGE_LOCAL_PATH=.local-data/objects
SENSEMU_WORKER_TOKEN=sensemu-worker-local-only
SENSEMU_GATEWAY_TOKEN=sensemu-gateway-local-only
SENSEMU_PAYMENT_ADAPTER_TOKEN=sensemu-payment-adapter-local-only
SENSEMU_PLATFORM_REVIEW_TOKEN=sensemu-platform-review-local-only
SENSEMU_WEBHOOK_SIGNING_SECRET=sensemu-webhook-signing-local-only
SENSEMU_AUTH_MODE=development
SENSEMU_OIDC_ISSUER_URL=http://localhost:8081/realms/sensemu
SENSEMU_OIDC_AUDIENCE=sensemu-api
SENSEMU_OIDC_JWKS_URL=http://localhost:8081/realms/sensemu/protocol/openid-connect/certs
SENSEMU_DEVELOPMENT_USER_SUBJECT=local-developer
SENSEMU_DEVELOPMENT_USER_EMAIL=developer@localhost
SENSEMU_DEVELOPMENT_USER_NAME=SenseMu 本地开发者
SENSEMU_INFERENCE_GATEWAY_PUBLIC_URL=http://localhost:8080
SENSEMU_TRAINING_EXECUTION_LEASE_TIMEOUT_SECONDS=120
SENSEMU_TRAINING_EXECUTION_MAX_ATTEMPTS=3
SENSEMU_INFERENCE_RESERVATION_TIMEOUT_SECONDS=180

# Worker
SENSEMU_CELERY_BROKER_URL=redis://localhost:6379/1
SENSEMU_CELERY_RESULT_BACKEND=redis://localhost:6379/2
SENSEMU_ULTRALYTICS_DOCKER_IMAGE=ultralytics/ultralytics:latest-cpu
SENSEMU_DOCKER_GPUS=none
SENSEMU_LEASE_HEARTBEAT_INTERVAL_SECONDS=15

# Inference gateway
SENSEMU_GATEWAY_ENVIRONMENT=development
SENSEMU_GATEWAY_HOST=0.0.0.0
SENSEMU_GATEWAY_PORT=8080
SENSEMU_GATEWAY_RUNTIME_URL=
SENSEMU_GATEWAY_RUNTIME_TOKEN=sensemu-runtime-local-only
SENSEMU_GATEWAY_CONTROL_PLANE_URL=http://localhost:8000
SENSEMU_GATEWAY_CONTROL_PLANE_TOKEN=sensemu-gateway-local-only
SENSEMU_GATEWAY_CONTROL_PLANE_TIMEOUT_SECONDS=5
SENSEMU_GATEWAY_RUNTIME_TIMEOUT_SECONDS=60
SENSEMU_GATEWAY_METERING_TIMEOUT_SECONDS=5
SENSEMU_GATEWAY_HEALTH_TIMEOUT_SECONDS=2
SENSEMU_GATEWAY_WEB_ORIGIN=http://localhost:3000

# Ultralytics inference runtime
SENSEMU_RUNTIME_ENVIRONMENT=development
SENSEMU_RUNTIME_HOST=0.0.0.0
SENSEMU_RUNTIME_PORT=8090
SENSEMU_RUNTIME_TOKEN=sensemu-runtime-local-only
SENSEMU_RUNTIME_OBJECT_STORAGE_ENDPOINT=local://
SENSEMU_RUNTIME_OBJECT_STORAGE_ACCESS_KEY=sensemu
SENSEMU_RUNTIME_OBJECT_STORAGE_SECRET_KEY=change-me-in-local-env
SENSEMU_RUNTIME_OBJECT_STORAGE_BUCKET=sensemu-dev
SENSEMU_RUNTIME_OBJECT_STORAGE_REGION=us-east-1
SENSEMU_RUNTIME_OBJECT_STORAGE_LOCAL_PATH=.local-data/objects
SENSEMU_RUNTIME_CACHE_PATH=.local-data/inference-cache
SENSEMU_RUNTIME_MAX_CACHED_MODELS=2
SENSEMU_RUNTIME_MAX_MODEL_BYTES=2147483648
SENSEMU_RUNTIME_MAX_INPUT_BYTES=8388608
SENSEMU_RUNTIME_MAX_CONCURRENT_REQUESTS=1
SENSEMU_RUNTIME_QUEUE_TIMEOUT_SECONDS=2
SENSEMU_RUNTIME_DEVICE=cpu

# Optional identity provider
SENSEMU_KEYCLOAK_ADMIN=admin
SENSEMU_KEYCLOAK_ADMIN_PASSWORD=change-me-in-local-env
