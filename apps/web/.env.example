SENSEMU_API_URL=http://localhost:8000
VITE_SENSEMU_API_URL=http://localhost:8000
NEXT_PUBLIC_SENSEMU_API_URL=http://localhost:8000
# Production Web auth is an OIDC/BFF contract. Keep refresh tokens server-side.
NEXT_PUBLIC_SENSEMU_AUTH_MODE=development
NEXT_PUBLIC_SENSEMU_OIDC_AUTHORIZATION_ENDPOINT=
NEXT_PUBLIC_SENSEMU_OIDC_CLIENT_ID=
NEXT_PUBLIC_SENSEMU_OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
# Same-origin BFF login endpoint; it owns PKCE callback and server-side sessions.
NEXT_PUBLIC_SENSEMU_AUTH_LOGIN_URL=/auth/login
NEXT_PUBLIC_SENSEMU_OIDC_SCOPE=openid profile email

# Server-only BFF preflight. Keep these out of NEXT_PUBLIC_* and do not enable
# implementation readiness until the provider-specific callback/session code
# and its staging E2E evidence are in place.
SENSEMU_BFF_ENABLED=false
SENSEMU_BFF_IMPLEMENTATION_READY=false
SENSEMU_OIDC_ISSUER=http://localhost:8081/realms/sensemu
SENSEMU_OIDC_CLIENT_ID=sensemu-web
SENSEMU_OIDC_AUTHORIZATION_ENDPOINT=http://localhost:8081/realms/sensemu/protocol/openid-connect/auth
SENSEMU_OIDC_TOKEN_ENDPOINT=http://localhost:8081/realms/sensemu/protocol/openid-connect/token
SENSEMU_OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
SENSEMU_SESSION_STORE=redis
SENSEMU_SESSION_SECRET=replace-with-a-local-secret-at-least-32-bytes
